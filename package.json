{
  "name": "iml-markdown-editor",
  "version": "26.4.0",
  "description": "纯粹的 Markdown 编辑器：打开、写、保存。富文本 / 源码双模，原样保存，导出 PDF / HTML / Word。",
  "main": "dist-electron/main.js",
  "scripts": {
    "test": "vitest run",
    "predev": "npx tsc -p electron/tsconfig.json",
    "dev": "concurrently \"vite\" \"npx tsc -p electron/tsconfig.json -w\" \"(wait-on tcp:5173 || wait-on tcp:5174) && cross-env NODE_ENV=development ELECTRON_RUN_AS_NODE= electron .\"",
    "dev:web": "vite --port 5173 --strictPort",
    "build:web": "tsc && vite build",
    "tauri": "node scripts/tauri.mjs",
    "tauri:dev": "node scripts/tauri.mjs dev",
    "tauri:build": "node scripts/tauri.mjs build",
    "clean:electron": "node -e \"require('fs').rmSync('dist-electron',{recursive:true,force:true})\"",
    "build": "tsc && vite build && npm run clean:electron && tsc -p electron/tsconfig.json && electron-builder",
    "build:mac": "tsc && vite build && npm run clean:electron && tsc -p electron/tsconfig.json && electron-builder --mac",
    "build:win": "tsc && vite build && npm run clean:electron && tsc -p electron/tsconfig.json && electron-builder --win",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p electron/tsconfig.json",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "keywords": [
    "markdown",
    "editor",
    "electron",
    "tiptap",
    "minimalist"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.5",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tiptap/core": "^2.11.5",
    "@tiptap/extension-bubble-menu": "^2.11.5",
    "@tiptap/extension-code-block-lowlight": "^2.11.5",
    "@tiptap/extension-floating-menu": "^2.11.5",
    "@tiptap/extension-image": "^2.11.5",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/extension-table": "^2.11.5",
    "@tiptap/extension-table-cell": "^2.11.5",
    "@tiptap/extension-table-header": "^2.11.5",
    "@tiptap/extension-table-row": "^2.11.5",
    "@tiptap/extension-task-item": "^2.11.5",
    "@tiptap/extension-task-list": "^2.11.5",
    "@tiptap/extension-text-align": "^2.11.5",
    "@tiptap/extension-underline": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "@tiptap/suggestion": "^2.27.2",
    "@types/katex": "^0.16.8",
    "@types/marked": "^5.0.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@uiw/react-codemirror": "^4.25.8",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "docx": "^9.7.1",
    "dompurify": "^3.4.15",
    "electron": "^33.4.11",
    "electron-builder": "^26.8.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "katex": "^0.16.38",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.577.0",
    "marked": "^15.0.0",
    "mermaid": "^11.13.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.1",
    "vitest": "^5.0.0",
    "wait-on": "^9.0.4",
    "zustand": "^5.0.11"
  },
  "build": {
    "appId": "com.imoling.editor",
    "productName": "iML 编辑器",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist-electron/**/*.test.js",
      "assets/lite/icon-1024.png"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "Markdown Document",
        "description": "Markdown 文档",
        "mimeType": "text/markdown",
        "role": "Editor",
        "icon": "src-tauri/icons/icon.icns"
      }
    ],
    "mac": {
      "icon": "src-tauri/icons/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "iML-Editor-${version}-${arch}.${ext}",
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Markdown Document",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": [
              "net.daringfireball.markdown",
              "public.plain-text"
            ],
            "CFBundleTypeExtensions": [
              "md",
              "markdown",
              "mdown",
              "mkd"
            ],
            "CFBundleTypeMIMETypes": [
              "text/markdown",
              "text/plain"
            ]
          }
        ],
        "UTImportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "net.daringfireball.markdown",
            "UTTypeDescription": "Markdown Document",
            "UTTypeConformsTo": [
              "public.plain-text"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "md",
                "markdown",
                "mdown",
                "mkd"
              ],
              "public.mime-type": "text/markdown"
            }
          }
        ]
      },
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "icon": "src-tauri/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "src-tauri/icons/icon.ico",
      "uninstallerIcon": "src-tauri/icons/icon.ico",
      "installerHeaderIcon": "src-tauri/icons/icon.ico",
      "installerSidebar": "assets/installerSidebar.png",
      "installerHeader": "assets/installerHeader.png",
      "createDesktopShortcut": "always",
      "shortcutName": "iML 编辑器",
      "allowElevation": true,
      "runAfterFinish": true,
      "buildUniversalInstaller": false,
      "artifactName": "iML-Editor-Setup-${version}-${arch}.${ext}"
    },
    "electronLanguages": [
      "en",
      "en-US",
      "zh_CN",
      "zh-CN",
      "zh_TW",
      "zh-TW"
    ],
    "compression": "maximum"
  }
}
